NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<existing-atlas-cluster>/<existing-database>?retryWrites=true&w=majority&authSource=admin
JWT_SECRET=replace-with-a-long-random-secret

ADMIN_FRONTEND_URL=http://localhost:5173
TEACHER_FRONTEND_URL=http://localhost:5174
STUDENT_FRONTEND_URL=http://localhost:5175

PASSWORD_RESET_EMAIL_MODE=console
# Required when PASSWORD_RESET_EMAIL_MODE=resend
RESEND_API_KEY=
PASSWORD_RESET_FROM=

# Legacy alternative to MONGODB_URI. MONGO_CLUSTER is optional; when omitted,
# the backend uses its previously configured Atlas cluster.
# MONGO_USER=
# MONGO_PASS=
# MONGO_DB=
# MONGO_CLUSTER=
